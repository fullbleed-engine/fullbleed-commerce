DATABASE_URL=file:dev.sqlite
# Shopify CLI provides app credentials and URL during app dev.
# Deployment requires these from the app's own configuration; never commit them.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Stable random 32-byte key, encoded as 64 hex characters. See ../PRIVACY.md.
FULLBLEED_PRIVACY_KEY=
# Separate random 32-byte hex token for read-only operator monitoring.
FULLBLEED_MONITOR_TOKEN=
SHOPIFY_APP_URL=
SCOPES=read_orders
# Only honored when NODE_ENV=development AND Shopify confirms partnerDevelopment.
FULLBLEED_DEV_STORE=fullbleed-commerce-test.myshopify.com
# Production access uses Shopify App Pricing. There is no charge creation in code.
# Partner Dashboard organization ID, not the separate Dev Dashboard ID.
SHOPIFY_PARTNER_ORG_ID=5227588
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_HANDLE=
SHOPIFY_PLAN_HANDLES=
