// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  shop        String @id
  sellerName  String
  sellerLines String @default("")
  accent      String @default("#244a40")
  footer      String @default("Thank you for shopping with us.")
  paper       String @default("A4")
  design      String @default("studio")
}

model DocumentTemplate {
  shop     String
  kind     String
  content  String?
  revision String

  @@id([shop, kind])
}

model AutomationSettings {
  shop      String          @id
  enabled   Boolean         @default(false)
  updatedAt DateTime        @updatedAt
  jobs      AutomationJob[]
}

model AutomationJob {
  id               String             @id @default(uuid())
  shop             String
  settings         AutomationSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)
  runId            String
  handle           String
  orderId          String
  kind             String
  requestHash      String
  ttlHours         Int
  retryDeadline    DateTime
  status           String             @default("pending")
  attempts         Int                @default(0)
  leaseId          String?
  leaseUntil       DateTime?
  nextAttemptAt    DateTime?
  fingerprint      String?
  templateRevision String?
  pdfSha256        String?
  expiresAt        DateTime?
  lastError        String?
  downloads        Int                @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([shop, runId])
  @@index([shop, createdAt])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
