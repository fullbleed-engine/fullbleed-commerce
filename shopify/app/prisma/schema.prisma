// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgreementAcceptance {
  shop           String   @id
  version        String
  documentSha256 String
  actorId        String
  acceptedAt     DateTime @default(now())
}

model Brand {
  shop        String @id
  sellerName  String
  sellerLines String @default("")
  accent      String @default("#244a40")
  footer      String @default("Thank you for shopping with us.")
  paper       String @default("A4")
  design      String @default("studio")
}

model DocumentTemplate {
  shop     String
  kind     String
  content  String?
  revision String

  @@id([shop, kind])
}

model AutomationSettings {
  shop      String          @id
  enabled   Boolean         @default(false)
  updatedAt DateTime        @updatedAt
  jobs      AutomationJob[]
}

model AutomationJob {
  id               String             @id @default(uuid())
  shop             String
  settings         AutomationSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)
  runId            String
  handle           String
  orderId          String
  kind             String
  requestHash      String
  ttlHours         Int
  retryDeadline    DateTime
  status           String             @default("pending")
  attempts         Int                @default(0)
  leaseId          String?
  leaseUntil       DateTime?
  nextAttemptAt    DateTime?
  fingerprint      String?
  templateRevision String?
  pdfSha256        String?
  expiresAt        DateTime?
  lastError        String?
  downloads        Int                @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([shop, runId])
  @@index([shop, createdAt])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model UsagePeriod {
  id       String       @id @default(uuid())
  shop     String
  key      String
  startsAt DateTime?
  endsAt   DateTime
  used     Int          @default(0)
  orders   UsageOrder[]

  @@unique([shop, key])
  @@index([endsAt])
}

model UsageOrder {
  id            String      @id
  periodId      String
  period        UsagePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  shop          String
  orderId       String
  reservedUntil DateTime?
  completedAt   DateTime?

  @@unique([periodId, orderId])
  @@index([shop, orderId])
}

// Identifiers live in the encrypted export and keyed lookup hashes.
// Completed/redacted requests retain a minimal delivery-deduplication receipt.
model PrivacyRequest {
  id           String                @id @default(uuid())
  shop         String
  requestId    String
  customerKey  String?
  emailKey     String?
  snapshot     String?
  keyId        String?
  status       String                @default("ready")
  receivedAt   DateTime              @default(now())
  dueAt        DateTime
  finishedAt   DateTime?
  lastExportAt DateTime?
  exports      Int                   @default(0)
  orders       PrivacyRequestOrder[]

  @@unique([shop, requestId])
  @@index([shop, status, receivedAt])
  @@index([shop, customerKey])
  @@index([shop, emailKey])
  @@index([finishedAt])
}

model PrivacyRequestOrder {
  requestId String
  orderId   String
  request   PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, orderId])
  @@index([orderId])
}

// Random event receipts commit atomically with an erasure. Payloads are kept
// encrypted in independent recovery storage, never in these receipts.
model RecoveryReceipt {
  id         String   @id
  recordedAt DateTime @default(now())

  @@index([recordedAt])
}

// Bounded metadata only. No request bodies, tokens, documents, addresses or errors.
model AccessEvent {
  id             String    @id @default(uuid())
  shop           String
  actorType      String
  actorId        String
  operation      String
  orderId        String?
  requestId      String?
  jobId          String?
  outcome        String    @default("started")
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([shop, startedAt, id])
  @@index([shop, orderId])
  @@index([shop, requestId])
  @@index([startedAt])
}
