{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "shopify/app/Dockerfile",
    "watchPatterns": ["/shopify/**", "/src/**", "/pro/**", "/package*.json", "/railway.json", "/.dockerignore", "/LICENSE*"]
  },
  "deploy": {
    "numReplicas": 1,
    "region": "us-east",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "requiredMountPath": "/data",
    "overlapSeconds": 0,
    "drainingSeconds": 30,
    "limitOverride": {
      "containers": { "cpu": 0.5, "memoryBytes": 536870912 }
    }
  }
}
